{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "bracketSpacing": false,
  "sortTailwindcss": true,
  "ignorePatterns": ["**/*.scss", "**/*.css"],
}
